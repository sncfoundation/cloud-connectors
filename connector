#!/usr/bin/env bash
#
# connector — Sheet-Ops across clouds.
#
# Reads desired Deployments from the Sheeternetes apiserver (the Google Sheet is
# the source of truth) and reconciles them onto a pluggable cloud backend.
#
# Requires: bash, curl, jq. Backends may need extra tools (docker, DO_TOKEN).
#
# Config via env (or a .skctl.env file next to this script):
#   WEBAPP_URL=https://script.google.com/macros/s/XXXX/exec
#   TOKEN=CHANGE_ME_super_secret
#
# Testing / offline override:
#   SHEET_JSON='{"items":[...]}'   # inline apiserver JSON, OR
#   SHEET_JSON=/path/to/resp.json  # a file containing that JSON
#   When set, the apiserver is not contacted.
#
# Backends:
#   local-docker   run each deployment's image `replicas` times via `docker run`
#   digitalocean   reconcile onto DO App Platform (needs DO_TOKEN)
#
# Usage:
#   connector list
#   connector plan  <backend>
#   connector apply <backend>
#
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
[ -f "$here/.skctl.env" ] && . "$here/.skctl.env"
TOKEN="${TOKEN:-CHANGE_ME_super_secret}"

# Labels used to identify containers/apps this connector owns.
MANAGED_KEY="sheeternetes.managed"
DEPLOY_KEY="sheeternetes.deployment"

die() { echo "connector: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# --- apiserver access ------------------------------------------------------

# Emit the raw deployments JSON: either the SHEET_JSON override or a live GET.
fetch_raw() {
  if [ -n "${SHEET_JSON:-}" ]; then
    if [ -f "$SHEET_JSON" ]; then cat "$SHEET_JSON"; else printf '%s' "$SHEET_JSON"; fi
    return
  fi
  need curl
  local url="${WEBAPP_URL:-}"
  [ -n "$url" ] || die "set WEBAPP_URL (Apps Script /exec URL) or SHEET_JSON"
  curl -fsSL -m 30 "$url?token=$TOKEN&kind=deployments"
}

# Normalized desired state, one deployment per line: name<TAB>image<TAB>replicas
desired_tsv() {
  need jq
  fetch_raw | jq -r '
    .items[]
    | select((.name // "") != "" and (.image // "") != "")
    | [.name, .image, ((.replicas // 1) | if .=="" or .==null then 1 else . end | tonumber | floor)]
    | @tsv'
}

# --- reconcile planner (shared by plan and apply) --------------------------
#
# compute_actions <backend> reads the current backend state, diffs it against
# desired state, and prints action lines: VERB<TAB>unit<TAB>image
# VERBs: CREATE, KEEP, RECREATE (image drift), DELETE (unit no longer desired).

compute_actions() {
  local backend="$1"
  local wtmp htmp
  wtmp="$(mktemp)"; htmp="$(mktemp)"
  trap 'rm -f "$wtmp" "$htmp"' RETURN

  # desired: one unit per replica, as unit<TAB>image (sorted by unit)
  local name image replicas i unit
  while IFS=$'\t' read -r name image replicas; do
    [ -n "$name" ] || continue
    [ "$replicas" -ge 1 ] 2>/dev/null || replicas=0
    for ((i = 1; i <= replicas; i++)); do
      unit="$(unit_name "$backend" "$name" "$i")"
      printf '%s\t%s\n' "$unit" "$image"
    done
  done < <(desired_tsv) | LC_ALL=C sort -t "$(printf '\t')" -k1,1 -u > "$wtmp"

  # current backend state as unit<TAB>image (sorted by unit)
  "backend_${backend//-/_}_state" | LC_ALL=C sort -t "$(printf '\t')" -k1,1 > "$htmp"

  local tab; tab="$(printf '\t')"
  # CREATE: desired units absent from backend
  LC_ALL=C join -t "$tab" -v1 -o '1.1,1.2' "$wtmp" "$htmp" \
    | while IFS="$tab" read -r u img; do printf 'CREATE\t%s\t%s\n' "$u" "$img"; done
  # DELETE: backend units no longer desired
  LC_ALL=C join -t "$tab" -v2 -o '2.1,2.2' "$wtmp" "$htmp" \
    | while IFS="$tab" read -r u img; do printf 'DELETE\t%s\t%s\n' "$u" "$img"; done
  # matched units: KEEP when image matches, else RECREATE
  LC_ALL=C join -t "$tab" -o '1.1,1.2,2.2' "$wtmp" "$htmp" \
    | while IFS="$tab" read -r u wimg himg; do
        if [ "$wimg" = "$himg" ]; then printf 'KEEP\t%s\t%s\n' "$u" "$wimg"
        else printf 'RECREATE\t%s\t%s\n' "$u" "$wimg"; fi
      done
}

# --- backend: local-docker -------------------------------------------------

unit_name_local_docker() { printf 'sk_%s_%s' "$1" "$2"; }

# Print current managed containers: name<TAB>image
backend_local_docker_state() {
  command -v docker >/dev/null 2>&1 || return 0
  docker ps -a \
    --filter "label=${MANAGED_KEY}=true" \
    --format '{{.Names}}'$'\t''{{.Image}}' 2>/dev/null || true
}

backend_local_docker_apply() {
  need docker
  local verb unit image dep
  while IFS=$'\t' read -r verb unit image; do
    dep="${unit#sk_}"; dep="${dep%_*}"
    case "$verb" in
      KEEP)
        echo "keep      $unit"
        ;;
      DELETE)
        echo "delete    $unit"
        docker rm -f "$unit" >/dev/null
        ;;
      RECREATE)
        echo "recreate  $unit ($image)"
        docker rm -f "$unit" >/dev/null 2>&1 || true
        docker run -d --name "$unit" \
          --label "${MANAGED_KEY}=true" \
          --label "${DEPLOY_KEY}=${dep}" \
          "$image" >/dev/null
        ;;
      CREATE)
        echo "create    $unit ($image)"
        docker run -d --name "$unit" \
          --label "${MANAGED_KEY}=true" \
          --label "${DEPLOY_KEY}=${dep}" \
          "$image" >/dev/null
        ;;
    esac
  done
}

# --- backend: digitalocean (DO App Platform) -------------------------------
#
# Real DO API. Each Sheeternetes deployment maps to one DO App with a single
# service; `replicas` -> service instance_count. Serverless: the platform owns
# process lifecycle, restarts and autoscaling once the desired spec is applied.

DO_API="https://api.digitalocean.com/v2/apps"

do_guard() {
  [ -n "${DO_TOKEN:-}" ] || die "DO_TOKEN is not set — export a DigitalOcean API token (https://cloud.digitalocean.com/account/api/tokens)"
  need curl
}

# On DO the reconcile unit is the whole App (one per deployment), not a replica.
unit_name_digitalocean() { printf '%s' "$1"; }

# Print current DO apps we manage: app-name<TAB>image(repository:tag)
backend_digitalocean_state() {
  [ -n "${DO_TOKEN:-}" ] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  command -v jq   >/dev/null 2>&1 || return 0
  curl -fsSL -m 30 -H "Authorization: Bearer ${DO_TOKEN}" "$DO_API?per_page=200" 2>/dev/null \
    | jq -r '
        .apps[]?
        | . as $app
        | ($app.spec.services[0].image // {}) as $img
        | select($app.spec.services[0].envs[]? | select(.key=="SHEETERNETES_MANAGED") | .value == "true")
        | [ $app.spec.name,
            (($img.repository // "") + ":" + ($img.tag // "latest")) ]
        | @tsv' 2>/dev/null || true
}

# Build the DO App Platform spec JSON for one deployment.
# image "nginx:1.25" -> repository "nginx", tag "1.25" (defaults to "latest").
do_app_spec() {
  local name="$1" image="$2" replicas="$3" repo tag
  repo="${image%%:*}"
  if [ "$image" = "$repo" ]; then tag="latest"; else tag="${image##*:}"; fi
  jq -n \
    --arg name "$name" \
    --arg repo "$repo" \
    --arg tag "$tag" \
    --argjson count "$replicas" '
    {
      spec: {
        name: $name,
        services: [
          {
            name: $name,
            image: { registry_type: "DOCKER_HUB", repository: $repo, tag: $tag },
            instance_count: $count,
            instance_size_slug: "basic-xxs",
            envs: [ { key: "SHEETERNETES_MANAGED", value: "true", scope: "RUN_TIME" } ]
          }
        ]
      }
    }'
}

backend_digitalocean_apply() {
  do_guard
  # Capture desired state once; replica count lives on the service, not the unit.
  local dt; dt="$(desired_tsv)"

  local verb unit img line image replicas
  while IFS=$'\t' read -r verb unit img; do
    case "$verb" in
      KEEP)
        echo "keep      app/$unit"
        ;;
      DELETE)
        echo "delete    app/$unit  (POST-safe: skipping destructive DELETE by default)"
        # Deliberately not calling DELETE ${DO_API}/<id> automatically.
        ;;
      CREATE|RECREATE)
        line="$(printf '%s\n' "$dt" | awk -F'\t' -v n="$unit" '$1==n{print; exit}')"
        image="$(printf '%s' "$line" | cut -f2)"
        replicas="$(printf '%s' "$line" | cut -f3)"
        [ "$replicas" -ge 1 ] 2>/dev/null || replicas=1
        echo "apply     app/$unit ($image x$replicas)"
        do_app_spec "$unit" "$image" "$replicas" \
          | curl -fsS -m 30 -X POST "$DO_API" \
              -H "Authorization: Bearer ${DO_TOKEN}" \
              -H "Content-Type: application/json" \
              -d @- \
          | jq -r '.app.id // .id // "(no id returned)" | "  -> DO app id: " + .'
        ;;
    esac
  done
}

# --- dispatch --------------------------------------------------------------

unit_name() {
  local backend="$1"; shift
  "unit_name_${backend//-/_}" "$@"
}

known_backend() {
  case "$1" in
    local-docker|digitalocean) return 0 ;;
    *) return 1 ;;
  esac
}

cmd_list() {
  need jq
  printf 'NAME\tIMAGE\tREPLICAS\n'
  desired_tsv
}

cmd_plan() {
  local backend="${1:-}"
  known_backend "$backend" || die "unknown backend '$backend' (use: local-docker | digitalocean)"
  echo "# plan for backend: $backend"
  local verb unit image had=0
  while IFS=$'\t' read -r verb unit image; do
    had=1
    printf '  %-9s %s\t%s\n' "$verb" "$unit" "$image"
  done < <(compute_actions "$backend")
  [ "$had" -eq 1 ] || echo "  (no changes / no desired deployments)"
}

cmd_apply() {
  local backend="${1:-}"
  known_backend "$backend" || die "unknown backend '$backend' (use: local-docker | digitalocean)"
  echo "# applying to backend: $backend"
  compute_actions "$backend" | "backend_${backend//-/_}_apply"
  echo "# done"
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    list)  cmd_list ;;
    plan)  cmd_plan "${1:-}" ;;
    apply) cmd_apply "${1:-}" ;;
    -h|--help|help|*)
      grep '^#' "$0" | sed 's/^# \{0,1\}//'
      ;;
  esac
}

main "$@"
